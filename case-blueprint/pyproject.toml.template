[project]
name = "my-case-project"
version = "0.1.0"
description = "3D-printable case design project (generated from case-blueprints)"
requires-python = ">=3.11"
dependencies = [
    "cadquery>=2.4",
    "pyyaml>=6.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "ruff>=0.5",
]

[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[tool.setuptools]
py-modules = []

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.pytest.ini_options]
testpaths = ["tests"]
