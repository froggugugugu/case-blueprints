{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Read(./**)",
      "Glob",
      "Grep",
      "Write(./input/**)",
      "Write(./output/**)",
      "Edit(./input/**)",
      "Edit(./output/**)",
      "Edit(./project-config.yaml)",
      "Bash(.venv/bin/python *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(test *)",
      "Bash(stat *)",
      "Bash(shasum *)",
      "Bash(md5sum *)",
      "Bash(mkdir -p *)"
    ],
    "deny": [
      "Write(./schemas/**)",
      "Edit(./schemas/**)",
      "Write(./.claude/**)",
      "Edit(./.claude/**)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "WebFetch"
    ],
    "additional-directories": []
  },

  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-edit-validate.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/subagent-stop.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-gate.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-end.sh"
          }
        ]
      }
    ]
  },

  "statusLine": {
    "type": "command",
    "command": "bash .claude/hooks/statusline.sh"
  },

  "includeCoAuthoredBy": true
}
